# Copie para .env (desenvolvimento) ou .env.producao (servidor). Nunca versione o arquivo preenchido.

# --- Banco (produção: usado pelo docker-compose.prod.yml)
POSTGRES_USER=treinamento
POSTGRES_PASSWORD=
POSTGRES_DB=treinamento
# Desenvolvimento: banco do docker-compose.dev.yml
DATABASE_URL="postgresql://treinamento:treinamento_dev@localhost:5437/treinamento?schema=public"

# --- Segurança: gere com  openssl rand -base64 32
AUTH_SECRET=

# Endereço público do sistema (usado nos e-mails e no certificado)
URL_BASE="http://localhost:3500"
APP_PORTA=3150

# --- E-mail (códigos de acesso e lembretes). Sem SMTP_HOST = modo teste (aparece no log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Segurança em Dia <nao-responda@broadcastti.com.br>"

# --- Dados iniciais
SEED_ADMIN_EMAIL=
SEED_ADMIN_NOME=
SEED_DEMO=
